# LLM: Vercel AI Gateway. Locally use a key; on Vercel the project's OIDC token is used automatically.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
# Optional: override the model chains
# AI_GATEWAY_MODELS=openai/gpt-oss-120b,google/gemini-2.5-flash-lite,alibaba/qwen3.7-flash
# AI_GATEWAY_PARSE_MODELS=google/gemini-2.5-flash-lite,openai/gpt-oss-120b,openai/gpt-oss-20b

# Optional but recommended: real place data from Geoapify (free key, no card: https://myprojects.geoapify.com).
# Without it the planner uses Photon (keyless OpenStreetMap search), then curated data.
# GEOAPIFY_API_KEY=your-geoapify-key
