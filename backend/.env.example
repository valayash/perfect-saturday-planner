# Any one provider is enough. On Vercel, AI Gateway uses the project's OIDC token automatically.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-4-hydrogen
# GEMINI_PARSE_MODEL=gemini-3.5-flash-lite
# Optional: real place data from Geoapify (free key, no card: https://myprojects.geoapify.com). Without it, the
# planner uses the public OpenStreetMap servers (Overpass/Photon), then curated data.
# GEOAPIFY_API_KEY=your-geoapify-key
